{
  "private": true,
  "name": "data_connector",
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "build": "npx @canva/cli apps build",
    "format": "prettier '**/*.{css,ts,tsx}' --no-config --write",
    "format:check": "prettier '**/*.{css,ts,tsx}' --no-config --check",
    "format:file": "prettier $1 --no-config --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "npm run lint && npm run lint:types",
    "lint:types": "tsc",
    "start": "npx @canva/cli apps start",
    "start:preview": "npx @canva/cli apps start --preview",
    "test": "jest --no-cache --passWithNoTests",
    "test:watch": "jest --watchAll",
    "test:update": "npm run test -- -u",
    "postinstall": "tsx ./scripts/copy_env.ts"
  },
  "dependencies": {
    "@canva/app-hooks": "^0.0.0-beta.4",
    "@canva/app-i18n-kit": "^1.3.0",
    "@canva/app-ui-kit": "^5.14.0",
    "@canva/asset": "^2.3.0",
    "@canva/design": "^2.12.0",
    "@canva/error": "^2.2.1",
    "@canva/intents": "^2.6.0",
    "@canva/platform": "^2.2.2",
    "@canva/user": "^2.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "6.0.0",
    "react-intl": "^7.1.11",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@canva/app-eslint-plugin": "^1.0.0",
    "@canva/app-scripts": "^1.0.0",
    "@rspack/core": "2.0.8",
    "@swc/core": "1.15.1",
    "@swc/jest": "0.2.39",
    "@swc/plugin-formatjs": "8.0.0",
    "@testing-library/react": "16.3.0",
    "@types/debug": "4.1.12",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.19.17",
    "@types/node-fetch": "2.6.13",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/webpack-env": "1.18.8",
    "debug": "4.4.1",
    "express": "4.22.2",
    "express-basic-auth": "1.2.1",
    "jest": "30.2.0",
    "jest-css-modules-transform": "4.4.2",
    "jest-environment-jsdom": "30.2.0",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "3.2.0",
    "node-fetch": "3.3.2",
    "prettier": "3.6.2",
    "ts-jest": "29.4.1",
    "tsx": "4.22.4",
    "typescript": "5.9.2"
  }
}
