{
  "private": true,
  "name": "gen_ai",
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "build": "npx @canva/cli apps build",
    "format": "prettier '**/*.{css,ts,tsx}' --no-config --write",
    "format:check": "prettier '**/*.{css,ts,tsx}' --no-config --check",
    "format:file": "prettier $1 --no-config --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "npm run lint && npm run lint:types",
    "lint:types": "tsc",
    "start": "npx @canva/cli apps start",
    "start:preview": "npx @canva/cli apps start --preview",
    "test": "jest --no-cache --passWithNoTests",
    "test:watch": "jest --watchAll",
    "postinstall": "tsx ./scripts/copy_env.ts"
  },
  "dependencies": {
    "@canva/app-hooks": "^0.0.0-beta.4",
    "@canva/app-i18n-kit": "^1.3.0",
    "@canva/app-middleware": "^0.0.0-beta.10",
    "@canva/app-ui-kit": "^5.15.0",
    "@canva/asset": "^2.3.1",
    "@canva/design": "^2.13.1",
    "@canva/error": "^2.2.2",
    "@canva/intents": "^2.7.1",
    "@canva/platform": "^2.2.3",
    "@canva/user": "^2.3.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "html-react-parser": "5.2.17",
    "obscenity": "0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "6.1.6",
    "react-intl": "^7.1.11",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@canva/app-eslint-plugin": "^1.0.1",
    "@canva/app-scripts": "^1.1.2",
    "@rspack/core": "2.0.8",
    "@swc/core": "1.16.20",
    "@swc/jest": "0.2.39",
    "@swc/plugin-formatjs": "14.0.0",
    "@testing-library/react": "16.3.3",
    "@types/cors": "2.8.19",
    "@types/debug": "4.1.13",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/node-fetch": "2.6.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webpack-env": "1.18.8",
    "debug": "4.4.3",
    "exponential-backoff": "3.1.3",
    "express": "4.22.3",
    "express-basic-auth": "1.2.1",
    "jest": "30.5.2",
    "jest-css-modules-transform": "4.4.2",
    "jest-environment-jsdom": "30.5.2",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "3.2.2",
    "node-fetch": "3.3.2",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "nwsapi": "2.2.24",
    "react-infinite-scroller": {
      "react": "^19.2.7"
    },
    "@canva/app-scripts": {
      "@rspack/core": "$@rspack/core"
    }
  }
}
