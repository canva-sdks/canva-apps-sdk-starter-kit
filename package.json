{
  "name": "canva-apps-sdk-starter-kit",
  "description": "A boilerplate for creating Canva Apps.",
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "start": "npx @canva/cli apps start",
    "start:example": "tsx ./scripts/examples.ts",
    "start:preview": "npx @canva/cli apps start --preview",
    "build": "npx @canva/cli apps build",
    "lint:types": "tsc",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:check": "npm run lint && npm run lint:types",
    "format": "prettier '{examples,src,utils,scripts}/**/*.{css,ts,tsx,json,js,mjs}' --write",
    "format:check": "prettier '{examples,src,utils,scripts}/**/*.{css,ts,tsx,json,js,mjs}' --check",
    "format:file": "prettier $1 --no-config --write",
    "test": "jest --no-cache --detectOpenHandles --passWithNoTests",
    "test:watch": "jest --no-cache --watch",
    "postinstall": "tsx ./scripts/copy_env.ts"
  },
  "keywords": [],
  "author": "Canva Pty Ltd.",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "workspaces": [
    "./examples/*/*"
  ],
  "dependencies": {
    "@canva/app-hooks": "^0.0.0-beta.4",
    "@canva/app-i18n-kit": "^1.3.0",
    "@canva/app-middleware": "^0.0.0-beta.8",
    "@canva/app-ui-kit": "^5.14.0",
    "@canva/asset": "^2.3.0",
    "@canva/design": "^2.12.0",
    "@canva/error": "^2.2.1",
    "@canva/intents": "^2.6.0",
    "@canva/platform": "^2.2.2",
    "@canva/user": "^2.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-intl": "^7.1.11"
  },
  "devDependencies": {
    "@canva/app-eslint-plugin": "^1.0.0",
    "@canva/app-scripts": "^1.0.0",
    "@eslint/eslintrc": "3.3.5",
    "@rspack/core": "2.0.8",
    "@swc/core": "1.15.1",
    "@swc/jest": "0.2.39",
    "@swc/plugin-formatjs": "8.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/debug": "4.1.12",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.19.17",
    "@types/node-fetch": "2.6.13",
    "@types/prompts": "2.4.9",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/webpack-env": "1.18.8",
    "@types/yargs": "17.0.33",
    "ajv-cli": "5.0.0",
    "debug": "4.4.1",
    "eslint": "9.34.0",
    "eslint-plugin-formatjs": "5.4.2",
    "eslint-plugin-import-x": "4.16.1",
    "eslint-plugin-jest": "28.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-testing-library": "7.13.3",
    "eslint-plugin-unicorn": "61.0.2",
    "exponential-backoff": "3.1.2",
    "express": "4.22.2",
    "express-basic-auth": "1.2.1",
    "globals": "16.3.0",
    "jest": "30.2.0",
    "jest-css-modules-transform": "4.4.2",
    "jest-environment-jsdom": "30.2.0",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "3.2.0",
    "mobx": "6.16.1",
    "node-fetch": "3.3.2",
    "postcss": "8.5.23",
    "prettier": "3.6.2",
    "prompts": "2.4.2",
    "ts-jest": "29.4.1",
    "tsx": "4.22.4",
    "typescript": "5.9.2",
    "typescript-eslint": "8.57.1",
    "webpack": "5.105.2",
    "webpack-dev-server": "5.2.6",
    "yargs": "17.7.2",
    "zod": "3.25.76"
  },
  "overrides": {
    "react-infinite-scroller": {
      "react": "$react"
    },
    "@canva/app-scripts": {
      "@rspack/core": "$@rspack/core"
    }
  }
}
